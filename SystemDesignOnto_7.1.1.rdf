<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign">
	<rdfs:comment xml:lang="en">This is an ontology developping for system design model, for example activity diagram and component diagram. It follows BFO and IOF. The prefix "SysDO" signifies "system design ontology" for abbreviation.</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#PortFunction">
	<rdfs:comment>port function</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#IncomingPort">
	<rdfs:comment xml:lang="en">Through incoming port p1, component C receives data</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#OutgoingPort">
	<rdfs:comment xml:lang="en">Through outgoing port p1, component C sends data the its next stop</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign">
	<rdfs:label xml:lang="en">System Design Ontology</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#handlesMaterial">
	<rdfs:label xml:lang="en">handles material</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#Port">
	<rdfs:label>port</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#hasFunctionPartAtAllTimes">
	<rdfs:label>has function part at all times</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#hasFunctionPartAtSomeTime">
	<rdfs:label>has function part at some time</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.pics.lgp.uttop.fr/ontologies/systemdesign#hasInputState">
	<rdfs:label xml:lang="en">has input state</rdfs:label>
</rdf:Description>

